{
  "info": {
    "_postman_id": "e9bbab68-9414-4112-8cc8-91f6b62c965b",
    "name": "BookNest API Demo",
    "description": "Demo and smoke-test flows for the BookNest catalog, auth, loans, reservations, reading profile, inventory, and security APIs. Set customer/admin credentials in collection variables before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "customerEmail", "value": "customer@booknest.vn" },
    { "key": "customerPassword", "value": "" },
    { "key": "adminEmail", "value": "admin@booknest.vn" },
    { "key": "adminPassword", "value": "" },
    { "key": "bookId", "value": "" },
    { "key": "loanId", "value": "" },
    { "key": "reservationId", "value": "" }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/health/db", "host": ["{{baseUrl}}"], "path": ["api", "health", "db"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Database health returns 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Request correlation header is present', function () { pm.expect(pm.response.headers.get('x-request-id')).to.be.a('string').and.not.empty; });"
            ]
          }
        }
      ]
    },
    {
      "name": "Catalog - find available book",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/books?limit=50&availableOnly=true&sort=title",
          "host": ["{{baseUrl}}"],
          "path": ["api", "books"],
          "query": [
            { "key": "limit", "value": "50" },
            { "key": "availableOnly", "value": "true" },
            { "key": "sort", "value": "title" }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Catalog response includes pagination metadata', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.meta.total).to.be.greaterThan(0);",
              "  pm.expect(body.meta.pageCount).to.be.a('number');",
              "  const book = body.data.find((item) => item.available > 0);",
              "  pm.expect(book, 'At least one book should be available for the demo').to.exist;",
              "  if (book) pm.collectionVariables.set('bookId', book.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login - customer",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{customerEmail}}\",\n  \"password\": \"{{customerPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Customer login succeeds', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().user.role).to.eql('USER');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "List active login sessions",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/account/sessions", "host": ["{{baseUrl}}"], "path": ["api", "account", "sessions"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Only the authenticated account sessions are returned', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create loan",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Idempotency-Key", "value": "loan-demo-{{$guid}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": \"{{bookId}}\",\n  \"days\": 3\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/loans", "host": ["{{baseUrl}}"], "path": ["api", "loans"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Loan is created and can be returned', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  const loan = body.data[0];",
              "  pm.expect(loan).to.have.property('id');",
              "  pm.collectionVariables.set('loanId', loan.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Return loan",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"condition\": \"GOOD\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/loans/{{loanId}}/return", "host": ["{{baseUrl}}"], "path": ["api", "loans", "{{loanId}}", "return"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Loan return succeeds', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json()).to.have.property('returnedAt');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Create reservation",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bookId\": \"{{bookId}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/reservations", "host": ["{{baseUrl}}"], "path": ["api", "reservations"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Reservation enters the queue or is ready immediately', function () {",
              "  pm.response.to.have.status(201);",
              "  const body = pm.response.json();",
              "  pm.expect(['WAITING', 'READY']).to.include(body.status);",
              "  pm.collectionVariables.set('reservationId', body.id);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Cancel reservation",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/reservations/{{reservationId}}", "host": ["{{baseUrl}}"], "path": ["api", "reservations", "{{reservationId}}"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Reservation can be cancelled and copy released', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().status).to.eql('CANCELLED');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reading profile",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/reading/profile", "host": ["{{baseUrl}}"], "path": ["api", "reading", "profile"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Reading profile belongs to the current user', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().profile.monthlyReadingGoal).to.be.a('number');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Authorization - customer is denied admin access",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/admin/security/alerts", "host": ["{{baseUrl}}"], "path": ["api", "admin", "security", "alerts"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Customer cannot access administrator APIs', function () {",
              "  pm.response.to.have.status(403);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Login - admin",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin login succeeds', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().user.role).to.eql('ADMIN');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin security alerts",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/admin/security/alerts", "host": ["{{baseUrl}}"], "path": ["api", "admin", "security", "alerts"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin security API is authorized', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Admin inventory movements",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/admin/inventory/movements?limit=10", "host": ["{{baseUrl}}"], "path": ["api", "admin", "inventory", "movements"], "query": [{ "key": "limit", "value": "10" }] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin can inspect inventory history', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().data).to.be.an('array');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
